{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":disableRateLimiting",
    "regexManagers:githubActionsVersions"
  ],
  "flux": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Disable docker image update of flux, we use flux manager to update it. Also disables Camunda which is in a private registry",
      "matchPackagePatterns": [
        "^ghcr.io/fluxcd/.*",
        "hmctsprivate.azurecr.io/camunda/optimize",
        "hmctsprod.azurecr.io/camunda/optimize"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["hmcts/jenkins-packer"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require manual merging for Jenkins controller updates by default",
      "matchPackageNames": ["hmctsprod.azurecr.io/jenkins/jenkins"],
      "groupName": "Jenkins controller and chart versions",
      "groupSlug": "jenkins-versions",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false,
      "platformAutomerge": false,
      "automergeType": "pr",
      "schedule": "before 6am every weekday",
      "automergeSchedule": ["before 6am every weekday"]
    },
    {
      "description": "Automerge Jenkins controller updates in sandbox only",
      "matchPackageNames": ["hmctsprod.azurecr.io/jenkins/jenkins"],
      "groupName": "Jenkins sandbox updates",
      "groupSlug": "jenkins-sandbox",
      "matchFileNames": [
        "**/*sbox*/jenkins-controller-version.yaml"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require manual merging for Jenkins chart updates by default.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["jenkins"],
      "versioning": "semver",
      "groupName": "Jenkins controller and chart versions",
      "groupSlug": "jenkins-versions",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false,
      "platformAutomerge": false,
      "automergeType": "pr",
      "schedule": "before 6am every weekday",
      "automergeSchedule": ["before 6am every weekday"]
    },
    {
      "description": "Automerge Jenkins chart minor and patch updates in sandbox only",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["jenkins"],
      "groupName": "Jenkins sandbox updates",
      "groupSlug": "jenkins-sandbox",
      "matchFileNames": [
        "**/*sbox*/jenkins.yaml"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require manual merging for k8s-sidecar by default",
      "matchPackageNames": ["hmctsprod.azurecr.io/imported/kiwigrid/k8s-sidecar"],
      "groupName": "Jenkins controller and chart versions",
      "groupSlug": "jenkins-versions",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false,
      "platformAutomerge": false,
      "automergeType": "pr",
      "schedule": "before 6am every weekday",
      "automergeSchedule": ["before 6am every weekday"]
    },
    {
      "description": "Automerge k8s-sidecar minor and patch updates in sandbox only",
      "matchPackageNames": ["hmctsprod.azurecr.io/imported/kiwigrid/k8s-sidecar"],
      "matchFileNames": [
        "**/*sbox**/jenkins.yaml"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Jenkins sandbox updates",
      "groupSlug": "jenkins-sandbox",
      "automerge": true,
      "automergeType": "pr",
      "schedule": "before 6am every weekday",
      "automergeSchedule": ["before 6am every weekday"]
    }
  ],
  "regexManagers": [
    {
      "description": "Update Jenkins image",
      "fileMatch": [
        "jenkins-controller-version\\.yaml$"
      ],
      "matchStrings": [
        "tag: (?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "hmctsprod.azurecr.io/jenkins/jenkins",
      "versioningTemplate": "maven"
    },
    {
      "description": "Update k8s-sidecar image (hmctsprod)",
      "fileMatch": [
        "jenkins\\.yaml$"
      ],
      "matchStrings": [
        "tag: (?<currentValue>.*)\\s+"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "hmctsprod.azurecr.io/imported/kiwigrid/k8s-sidecar",
      "versioningTemplate": "maven"
    },
    {
      "description": "Update Jenkins image gallery version",
      "fileMatch": [
        "jenkins\\.yaml$", "jenkins-azure-vm-agent\\.yaml$"
      ],
      "matchStrings": [
        "galleryImageVersion: \"(?<currentValue>.*)\"\\s+"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hmcts/jenkins-packer",
      "versioningTemplate": "maven"
    }
  ],
  "commitMessageSuffix": "in {{parentDir}}",
  "additionalBranchPrefix": "{{parentDir}}-"
}
