{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard",
    "regexManagers:dockerfileVersions"
  ],
  "description": "Onboarding preset for use with HMCTS's repositories",
  "timezone": "Europe/London",
  "schedule": "after 7am and before 11am every weekday",
  "labels": [
    "dependencies"
  ],
  "helmv3": {
    "fileMatch": [
      "\\Chart.yaml$"
    ],
    "bumpVersion": "patch",
    "registryAliases": {
      "hmctspublic": "oci://hmctspublic.azurecr.io/helm",
      "hmctsprod": "oci://hmctsprod.azurecr.io/helm"
    }
  },
  "packageRules": [
    {
      "groupName": "flyway",
      "matchPackageNames": [
        "flyway"
      ]
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "hmcts/cnp-jenkins-library"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "hmcts/cnp-jenkins-library"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "The java Helm chart is not a Java runtime - lift the built-in Java LTS version filter (workarounds:javaLTSVersions matches deps named java)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "hmctsprod.azurecr.io/helm/java",
        "hmctspublic.azurecr.io/helm/java"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "versioning": "semver"
    },
    {
      "description": "A Node version is pinned in up to three files - the Docker base image tag, .nvmrc and the @types/node devDependency - and Renovate sees each through a different datasource. Group the major bumps so one PR moves the whole repo to the same Node major instead of three PRs that leave the files on different majors. Package name matching mirrors group:nodeJs and workarounds:nodeDockerVersioning so the same images are in scope.",
      "groupName": "Node.js",
      "matchDatasources": [
        "docker",
        "node-version"
      ],
      "matchPackageNames": [
        "/(?:^|/)node$/",
        "!calico/node",
        "!docker.io/calico/node",
        "!ghcr.io/devcontainers/features/node",
        "!kindest/node",
        "!docker.io/kindest/node"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "description": "Join @types/node major bumps to the Node.js group so the types major cannot land on its own and leave the repo typed against a runtime it does not use. Minor and patch are deliberately left out of the group so type-definition fixes keep flowing on their own cadence.",
      "groupName": "Node.js",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/node"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "description": "The Node.js group holds one branch, so each member must offer at most one major target or two upgrades would fight over the same file. This is the Renovate default - it is restated here so a repo that turns separateMultipleMajor on globally does not break the group. It must not carry matchUpdateTypes: lookup-stage options are evaluated before the update type is known.",
      "matchDatasources": [
        "docker",
        "node-version",
        "npm"
      ],
      "matchPackageNames": [
        "/(?:^|/)node$/",
        "@types/node",
        "!calico/node",
        "!docker.io/calico/node",
        "!ghcr.io/devcontainers/features/node",
        "!kindest/node",
        "!docker.io/kindest/node"
      ],
      "separateMultipleMajor": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track @Library versions in Jenkinsfiles via GitHub tags",
      "managerFilePatterns": [
        "/^Jenkinsfile_.*$/"
      ],
      "matchStrings": [
        "@Library\\(\\s*(?:value\\s*=\\s*)?[\"'](?<depName>[^@\"']+)@(?<currentValue>[^\"']+)[\"'](?:\\s*,\\s*changelog\\s*=\\s*(?:true|false))?\\s*\\)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "hmcts/cnp-jenkins-library",
      "depNameTemplate": "Jenkins-{{{depName}}}",
      "versioningTemplate": "semver"
    }
  ],
  "hostRules": [
    {
      "description": "OCI scheme + appid/secret",
      "matchHost": "oci://hmctsprod.azurecr.io/helm",
      "hostType": "docker",
      "username": "{{ secrets.RENOVATE_ACR_APPID }}",
      "password": "{{ secrets.RENOVATE_ACR_SECRET }}"
    },
    {
      "description": "HTTPS scheme + appid/secret (matches documented pattern)",
      "matchHost": "https://hmctsprod.azurecr.io/helm",
      "hostType": "docker",
      "username": "{{ secrets.RENOVATE_ACR_APPID }}",
      "password": "{{ secrets.RENOVATE_ACR_SECRET }}"
    },
    {
      "description": "Hostname only + appid/secret (too broad)",
      "matchHost": "hmctsprod.azurecr.io",
      "username": "{{ secrets.RENOVATE_ACR_APPID }}",
      "password": "{{ secrets.RENOVATE_ACR_SECRET }}"
    }
  ]
}
