{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":disableRateLimiting",
    "regexManagers:githubActionsVersions"
  ],
  "flux": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Disable docker image update of flux, we use flux manager to update it. Also disables Camunda which is in a private registry",
      "matchPackagePatterns": [
        "^ghcr.io/fluxcd/.*",
        "hmctsprivate.azurecr.io/camunda/optimize",
        "hmctsprod.azurecr.io/camunda/optimize"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["hmcts/jenkins-packer"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Group Jenkins controller updates across environments; require manual merging by default.",
      "matchPackageNames": ["hmctsprod.azurecr.io/jenkins/jenkins"],
      "groupName": "Jenkins controller and chart versions",
      "groupSlug": "jenkins-versions",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "automerge": false,
      "platformAutomerge": false,
      "automergeType": "pr",
      "schedule": "before 6am every weekday",
      "automergeSchedule": ["before 6am every weekday"]
    },
    {
      "description": "Automerge only Jenkins controller minor and patch updates",
      "matchPackageNames": ["hmctsprod.azurecr.io/jenkins/jenkins"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["enhancement"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Label Jenkins controller major updates as breaking changes",
      "matchPackageNames": ["hmctsprod.azurecr.io/jenkins/jenkins"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-change"]
    },
    {
      "description": "Group Jenkins chart updates across environments; require manual merging by default.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["jenkins"],
      "matchFileNames": ["**/jenkins.yaml"],
      "versioning": "semver",
      "groupName": "Jenkins controller and chart versions",
      "groupSlug": "jenkins-versions",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "automerge": false,
      "platformAutomerge": false,
      "automergeType": "pr",
      "schedule": "before 6am every weekday",
      "automergeSchedule": ["before 6am every weekday"]
    },
    {
      "description": "Automerge only Jenkins chart minor and patch updates",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["jenkins"],
      "matchFileNames": ["**/jenkins.yaml"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["enhancement"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Label Jenkins chart major updates as breaking changes and require manual merging",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["jenkins"],
      "matchFileNames": ["**/jenkins.yaml"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-change"],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchPackageNames": ["hmctsprod.azurecr.io/imported/kiwigrid/k8s-sidecar"],
      "automerge": true,
      "automergeType": "pr",
      "schedule": "before 6am every weekday",
      "automergeSchedule": ["before 6am every weekday"]
    }
  ],
  "regexManagers": [
    {
      "description": "Update Jenkins image",
      "fileMatch": [
        "jenkins-controller-version\\.yaml$"
      ],
      "matchStrings": [
        "tag: (?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "hmctsprod.azurecr.io/jenkins/jenkins",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)$"
    },
    {
      "description": "Update k8s-sidecar image (hmctsprod)",
      "fileMatch": [
        "jenkins\\.yaml$"
      ],
      "matchStrings": [
        "tag: (?<currentValue>.*)\\s+"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "hmctsprod.azurecr.io/imported/kiwigrid/k8s-sidecar",
      "versioningTemplate": "maven"
    },
    {
      "description": "Update Jenkins image gallery version",
      "fileMatch": [
        "jenkins\\.yaml$", "jenkins-azure-vm-agent\\.yaml$"
      ],
      "matchStrings": [
        "galleryImageVersion: \"(?<currentValue>.*)\"\\s+"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hmcts/jenkins-packer",
      "versioningTemplate": "maven"
    }
  ],
  "commitMessageSuffix": "in {{parentDir}}",
  "additionalBranchPrefix": "{{parentDir}}-"
}
